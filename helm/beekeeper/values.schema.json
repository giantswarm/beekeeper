{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "authenticationMode": {
                    "type": "string",
                    "description": "The authentication mode of every fromEndpoints ingress rule (Cilium mutual authentication). Empty: none."
                },
                "dns": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ports": {
                            "type": "array",
                            "description": "The DNS pods' ports (UDP and TCP).",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "selector": {
                            "type": "object",
                            "description": "The labels of the cluster's DNS pods.",
                            "additionalProperties": true,
                            "properties": {
                                "io.kubernetes.pod.namespace": {
                                    "type": "string"
                                },
                                "k8s-app": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create CiliumNetworkPolicies for the engine, the receiver and (postgres.enabled) Postgres. A cluster with a default-deny policy needs them."
                },
                "engine": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "fqdns": {
                            "type": "array",
                            "description": "The hosts the engine reaches over HTTPS: GitHub's API and JEV.",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "gateway": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "selector": {
                            "type": "object",
                            "description": "The pods of the gateway the webhook route goes through. Empty: no webhooks.",
                            "additionalProperties": true,
                            "properties": {
                                "io.kubernetes.pod.namespace": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "postgres": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Create the policy of the Postgres pods too."
                        },
                        "metricsPort": {
                            "type": "integer",
                            "description": "The instance manager's metrics port."
                        },
                        "operatorSelector": {
                            "type": "object",
                            "description": "The operator's pods.",
                            "additionalProperties": true,
                            "properties": {
                                "app.kubernetes.io/name": {
                                    "type": "string"
                                },
                                "io.kubernetes.pod.namespace": {
                                    "type": "string"
                                }
                            }
                        },
                        "selector": {
                            "type": "object",
                            "description": "The labels of the Postgres pods. Empty: cnpg.io/cluster: <postgres.cluster>.",
                            "additionalProperties": true
                        },
                        "statusPort": {
                            "type": "integer",
                            "description": "The instance manager's status port (the operator and kubelet probes)."
                        }
                    }
                },
                "probeEntities": {
                    "type": "array",
                    "description": "The entities kubelet probes come from.",
                    "items": {
                        "type": "string"
                    }
                },
                "prometheus": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "selector": {
                            "type": "object",
                            "description": "The Prometheus pods' labels. Empty: no scrapes.",
                            "additionalProperties": true,
                            "properties": {
                                "app.kubernetes.io/name": {
                                    "type": "string"
                                },
                                "io.kubernetes.pod.namespace": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "engine": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affinity": {
                    "type": "object",
                    "description": "The engine pods' affinity. Empty: a soft anti-affinity that spreads the replicas over nodes.",
                    "additionalProperties": true
                },
                "extraArgs": {
                    "type": "array",
                    "description": "Further arguments of `beekeeper engine`.",
                    "items": {
                        "type": "string"
                    }
                },
                "extraEnv": {
                    "type": "array",
                    "description": "Further environment variables of the engine container.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            },
                            "valueFrom": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                },
                "leaderElectionID": {
                    "type": "string",
                    "description": "The Lease the replicas elect their leader with. Empty: <fullname>-engine."
                },
                "logLevel": {
                    "type": "string",
                    "description": "The log level (debug, info, error)."
                },
                "migrate": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "resources": {
                            "type": "object",
                            "description": "The resources of the init container that runs `beekeeper migrate`.",
                            "additionalProperties": true,
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "nodeSelector": {
                    "type": "object",
                    "description": "The engine pods' node selector.",
                    "additionalProperties": true
                },
                "podAnnotations": {
                    "type": "object",
                    "description": "Annotations of the engine pods.",
                    "additionalProperties": true
                },
                "podLabels": {
                    "type": "object",
                    "description": "Further labels of the engine pods.",
                    "additionalProperties": true
                },
                "ports": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "health": {
                            "type": "integer",
                            "description": "The health port (/healthz, /readyz)."
                        },
                        "metrics": {
                            "type": "integer",
                            "description": "The metrics port (/metrics)."
                        }
                    }
                },
                "replicas": {
                    "type": "integer",
                    "description": "Engine replicas. One leads (leader election) and decides; every one serves metrics."
                },
                "resources": {
                    "type": "object",
                    "description": "The engine container's resources.",
                    "additionalProperties": true,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "tolerations": {
                    "type": "array",
                    "description": "The engine pods' tolerations.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false
                    }
                },
                "topologySpreadConstraints": {
                    "type": "array",
                    "description": "The engine pods' topology spread constraints.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false
                    }
                }
            }
        },
        "externalDNSIP": {
            "type": "string"
        },
        "fullnameOverride": {
            "type": "string",
            "description": "The prefix of every object's name. Empty: the release's name."
        },
        "gcpProject": {
            "type": "string"
        },
        "github": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "apiURL": {
                    "type": "string",
                    "description": "GitHub's REST API (GraphQL at <apiURL>/graphql)."
                },
                "app": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "appIDKey": {
                            "type": "string",
                            "description": "The key of the App's id."
                        },
                        "installationIDKey": {
                            "type": "string",
                            "description": "The key of the id of the App's installation on the org."
                        },
                        "privateKeyKey": {
                            "type": "string",
                            "description": "The key of the App's private key (PEM)."
                        },
                        "secretName": {
                            "type": "string",
                            "description": "The Secret holding the GitHub App's id, its installation's id and its private key. Empty: <fullname>-github-app."
                        }
                    }
                }
            }
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "The image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "The registry of the beekeeper image."
                },
                "repository": {
                    "type": "string",
                    "description": "The repository of the beekeeper image."
                },
                "tag": {
                    "type": "string",
                    "description": "The image tag. Empty: the chart's appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "The names of the Secrets every pod pulls its image with.",
            "items": {
                "type": "string"
            }
        },
        "jev": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Ask JEV at the decision points in shadow mode. Off: the engine asks no JEV and mounts no key."
                },
                "secretKey": {
                    "type": "string",
                    "description": "The key of the JEV API key."
                },
                "secretName": {
                    "type": "string",
                    "description": "The Secret holding the JEV API key. Empty: <fullname>-jev."
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "podMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Create a PodMonitor (prometheus-operator) for the engine and one for the receiver."
                },
                "interval": {
                    "type": "string",
                    "description": "The scrape interval."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels a Prometheus selects PodMonitors by, e.g. release: kube-prometheus-stack.",
                    "additionalProperties": true
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "description": "The pod security context of every pod.",
            "additionalProperties": true,
            "properties": {
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cluster": {
                    "type": "string",
                    "description": "The CloudNativePG Cluster, which the host, the engine's Secret and the Postgres network policy derive from. Empty: <fullname>-db."
                },
                "database": {
                    "type": "string",
                    "description": "The database, owned by the role engine. The migrations grant the roles engine and receiver their privileges."
                },
                "engine": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "passwordKey": {
                            "type": "string",
                            "description": "The key of the role's password."
                        },
                        "secretName": {
                            "type": "string",
                            "description": "The basic-auth Secret of the role engine, the owner (it migrates). Empty: <cluster>-app, CloudNativePG's."
                        },
                        "usernameKey": {
                            "type": "string",
                            "description": "The key of the role's name."
                        }
                    }
                },
                "host": {
                    "type": "string",
                    "description": "The Postgres host. Empty: <cluster>-rw, the Cluster's read-write Service."
                },
                "port": {
                    "type": "integer",
                    "description": "The Postgres port."
                },
                "receiver": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "passwordKey": {
                            "type": "string",
                            "description": "The key of the role's password."
                        },
                        "secretName": {
                            "type": "string",
                            "description": "The basic-auth Secret of the role receiver, which may only insert into the inbox. Empty: <cluster>-receiver."
                        },
                        "usernameKey": {
                            "type": "string",
                            "description": "The key of the role's name."
                        }
                    }
                },
                "sslMode": {
                    "type": "string",
                    "description": "libpq's sslmode. CloudNativePG serves TLS with its own CA."
                }
            }
        },
        "prometheusRule": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "alertLabels": {
                    "type": "object",
                    "description": "Labels on every alert, e.g. cluster, layer and component.",
                    "additionalProperties": true
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create the alert rules (a PrometheusRule)."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels a Prometheus selects rules by, e.g. release: kube-prometheus-stack.",
                    "additionalProperties": true
                },
                "runbookURL": {
                    "type": "string",
                    "description": "A runbook's URL. Each alert links <runbookURL>#<alert name in lower case>. Empty: no links."
                },
                "selectors": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "engine": {
                            "type": "string",
                            "description": "The PromQL selector of the engine's series. Empty: its namespace and the job of its PodMonitor."
                        },
                        "receiver": {
                            "type": "string",
                            "description": "The PromQL selector of the receiver's series. Empty: its namespace and the job of its PodMonitor."
                        }
                    }
                },
                "severities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "engineDown": {
                            "type": "string",
                            "description": "BeekeeperEngineDown: no engine replica is scraped."
                        },
                        "historyDropped": {
                            "type": "string",
                            "description": "BeekeeperHistoryDropped: history rows were dropped."
                        },
                        "invariantViolated": {
                            "type": "string",
                            "description": "BeekeeperInvariantViolated: an invariant is violated for 10 minutes."
                        },
                        "invariantsMissing": {
                            "type": "string",
                            "description": "BeekeeperInvariantsMissing: the engine is up but exports no invariants."
                        },
                        "noLeader": {
                            "type": "string",
                            "description": "BeekeeperNoLeader: replicas are up, none leads."
                        },
                        "receiverDown": {
                            "type": "string",
                            "description": "BeekeeperReceiverDown: no receiver replica is scraped."
                        },
                        "receiverUnavailable": {
                            "type": "string",
                            "description": "BeekeeperReceiverUnavailable: the receiver answers 503 for 10 minutes."
                        },
                        "reconcileErrors": {
                            "type": "string",
                            "description": "BeekeeperReconcileErrors: a reconciler fails for 15 minutes."
                        },
                        "sourceDegraded": {
                            "type": "string",
                            "description": "BeekeeperSourceDegraded: a source is degraded for 30 minutes."
                        }
                    }
                },
                "watchdog": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "An alert that fires while an engine replica leads, for a dead-man's switch."
                        },
                        "labels": {
                            "type": "object",
                            "description": "Labels of the watchdog alert, e.g. the one your Alertmanager routes to the dead-man's switch.",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "receiver": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affinity": {
                    "type": "object",
                    "description": "The receiver pods' affinity. Empty: a soft anti-affinity that spreads the replicas over nodes.",
                    "additionalProperties": true
                },
                "extraArgs": {
                    "type": "array",
                    "description": "Further arguments of `beekeeper receiver`.",
                    "items": {
                        "type": "string"
                    }
                },
                "extraEnv": {
                    "type": "array",
                    "description": "Further environment variables of the receiver container.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            },
                            "valueFrom": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                },
                "logLevel": {
                    "type": "string",
                    "description": "The log level (debug, info, error)."
                },
                "maxBodyBytes": {
                    "type": "integer",
                    "description": "The largest body the receiver accepts, in bytes (inclusive)."
                },
                "maxInFlightBytes": {
                    "type": "integer",
                    "description": "The bodies a receiver holds at once, in bytes by their declared size (at least maxBodyBytes): a delivery that doesn't fit is answered 503 before its body is read, so unsigned bodies can't exhaust the memory limit. Default: four of the largest.",
                    "minimum": 0
                },
                "nodeSelector": {
                    "type": "object",
                    "description": "The receiver pods' node selector.",
                    "additionalProperties": true
                },
                "path": {
                    "type": "string",
                    "description": "The only path the receiver answers, with POST."
                },
                "podAnnotations": {
                    "type": "object",
                    "description": "Annotations of the receiver pods.",
                    "additionalProperties": true
                },
                "podLabels": {
                    "type": "object",
                    "description": "Further labels of the receiver pods.",
                    "additionalProperties": true
                },
                "ports": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "metrics": {
                            "type": "integer",
                            "description": "The metrics and health port (/metrics, /healthz, /readyz)."
                        },
                        "webhook": {
                            "type": "integer",
                            "description": "The webhook port, the only one the public route reaches."
                        }
                    }
                },
                "projectNodeIDs": {
                    "type": "array",
                    "description": "Required in production: the node ids of the boards (ProjectV2, PVT_...) the engine observes. Empty: every board's item deliveries are stored.",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "replicas": {
                    "type": "integer",
                    "description": "Receiver replicas. Each stores a verified delivery in the Postgres inbox before it answers."
                },
                "resources": {
                    "type": "object",
                    "description": "The receiver container's resources.",
                    "additionalProperties": true,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "description": "Annotations of the receiver Service.",
                            "additionalProperties": true
                        },
                        "port": {
                            "type": "integer",
                            "description": "The receiver Service's port, the backend of the webhook route."
                        }
                    }
                },
                "tolerations": {
                    "type": "array",
                    "description": "The receiver pods' tolerations.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false
                    }
                },
                "topologySpreadConstraints": {
                    "type": "array",
                    "description": "The receiver pods' topology spread constraints.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "description": "The security context of every container.",
            "additionalProperties": true,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "engineAnnotations": {
                    "type": "object",
                    "description": "Annotations of the engine's ServiceAccount.",
                    "additionalProperties": true
                },
                "receiverAnnotations": {
                    "type": "object",
                    "description": "Annotations of the receiver's ServiceAccount, which may do nothing in Kubernetes.",
                    "additionalProperties": true
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "webhook": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "secretKey": {
                    "type": "string",
                    "description": "The key of the webhook secret."
                },
                "secretName": {
                    "type": "string",
                    "description": "The Secret holding the GitHub App's webhook secret, which the receiver checks X-Hub-Signature-256 with. Empty: <fullname>-webhook."
                }
            }
        }
    }
}
